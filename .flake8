# NeonVision AI - lint configuration
# Author: ChamathDilshanC
#
# 88 columns matches the Black formatter used on this project, so Flake8 and
# Black never disagree about wrapping.

[flake8]
max-line-length = 88
max-complexity = 12
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    output,
    models
per-file-ignores =
    core/__init__.py:F401
    utils/__init__.py:F401
